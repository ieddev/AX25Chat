[Unit]
Description=AX25Chat: Direwolf (modem)
After=sound.target network.target ax25chat-rigctld.service
Wants=ax25chat-rigctld.service

[Service]
Type=simple
User=@GEBRUIKER@
WorkingDirectory=@MAP@
ExecStartPre=-/usr/bin/python3 @MAP@/ax25chat_radio.py --niveau
ExecStartPre=-/usr/bin/python3 @MAP@/ax25chat_rig.py --wacht
ExecStart=/usr/bin/direwolf -c @MAP@/direwolf.conf -t 0 -q d
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
