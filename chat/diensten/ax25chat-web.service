[Unit]
Description=AX25Chat: webserver (http://10.42.0.1)
After=network.target

[Service]
Type=simple
User=@GEBRUIKER@
WorkingDirectory=@MAP@
ExecStart=/usr/bin/python3 @MAP@/ax25chat_web.py --poort 80
# Poort 80 zonder root
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
